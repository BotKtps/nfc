{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/r/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/setup/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|r/|setup/).*)",
      "destination": "/index.html"
    }
  ]
}
